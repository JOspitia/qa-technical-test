    {
      "name": "calculator",
      "item": [
        {
          "name": "add",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Validar status code 200.\r\npm.test(\"Status code es 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Validar que el cuerpo de la respuesta es XML.\r\npm.test(\"La respuesta es XML\", function () {\r\n    pm.expect(pm.response.headers.get(\"content-type\")).to.include(\"xml\");\r\n});\r\n\r\n// 3. Validar que AddResult es exactamente 8 (5 + 3).\r\npm.test(\"AddResult es 8 (5 + 3)\", function () {\r\n    const xmlBody = pm.response.text();\r\n    const addResultMatch = xmlBody.match(/<AddResult>(\\d+)<\\/AddResult>/);\r\n    pm.expect(addResultMatch, \"AddResult debe existir en la respuesta\").to.not.be.null;\r\n    pm.expect(parseInt(addResultMatch[1]), \"AddResult debe ser 8\").to.eql(8);\r\n});\r\n\r\n// 4. Validar que la respuesta contiene el namespace correcto.\r\npm.test(\"Response contiene namespace tempuri.org\", function () {\r\n    const xmlBody = pm.response.text();\r\n    pm.expect(xmlBody).to.include(\"http://tempuri.org/\");\r\n});"
                ]
              }
            }
          ],
