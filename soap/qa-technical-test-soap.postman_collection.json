        {
          "name": "divide-invalid",
          "description": "Caso invalido: Division por cero. El servicio real devuelve HTTP 500 con faultstring 'Arithmetic operation resulted in an overflow' (NO 'divide by zero'). Respuesta verificada contra el servicio en vivo.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Validar que el servicio responde con status 500 (error interno).\r\npm.test(\"Status code es 500 - Error interno del servidor\", function () {\r\n    pm.response.to.have.status(500);\r\n});\r\n\r\n// 2. Validar que la respuesta es XML.\r\npm.test(\"La respuesta es XML\", function () {\r\n    pm.expect(pm.response.headers.get(\"content-type\")).to.include(\"xml\");\r\n});\r\n\r\n// 3. Validar que la respuesta contiene faultstring.\r\npm.test(\"La respuesta contiene faultstring\", function () {\r\n    const xmlBody = pm.response.text();\r\n    const hasFault = xmlBody.includes(\"faultstring\") || xmlBody.includes(\"Fault\");\r\n    pm.expect(hasFault, \"Debe contener faultstring\").to.be.true;\r\n});\r\n\r\n// 4. Validar que NO se devuelve DivideResult (error esperado).\r\npm.test(\"No se devuelve DivideResult en caso de error\", function () {\r\n    const xmlBody = pm.response.text();\r\n    const divideResultMatch = xmlBody.match(/<DivideResult>(\\d+)<\\/DivideResult>/);\r\n    pm.expect(divideResultMatch, \"No debe devolver DivideResult en division por cero\").to.be.null;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://tempuri.org/Divide\""
              }
            ],
